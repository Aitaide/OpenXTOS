# XTOS configuration fragment for Linux 7.3.1 with mainline PREEMPT_RT.
# Apply after the integration patch selected by kernel/source-pin.json.
CONFIG_EXPERT=y
CONFIG_PREEMPT_RT=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_HZ_1000=y
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_XTOS_SCHED=y
CONFIG_XTOS_BCI=m
CONFIG_XTOS_BCI_OPENBCI=m
CONFIG_SERIAL_DEV_BUS=y
CONFIG_SERIAL_DEV_CTRL_TTYPORT=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# Fail-closed userspace runner prerequisites; resolve and exercise separately
# in every architecture build. Landlock ABI >=3 is provided by Linux 6.6.
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_USER_NS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_SECURITY=y
CONFIG_SECURITYFS=y
CONFIG_SECURITY_LANDLOCK=y

# Production hardening prerequisites. Actual resolved config/build/latency and
# platform-specific pstore backend must be accepted separately. Signing trust
# and firmware enrollment are not implied by these software protections.
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_FORTIFY_SOURCE=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_SLAB_FREELIST_HARDENED=y
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_SECURITY_DMESG_RESTRICT=y
CONFIG_SECURITY_YAMA=y
CONFIG_MEMCG=y
CONFIG_CGROUP_PIDS=y
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_LSM="landlock,lockdown,yama,loadpin,safesetid,selinux,smack,tomoyo,apparmor,bpf"
