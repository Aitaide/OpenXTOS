# XTOS configuration fragment for Linux 6.6 + PREEMPT_RT.
# Apply after kernel/patches/xtos-linux-6.6.patch.
CONFIG_EXPERT=y
CONFIG_PREEMPT_RT=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_HZ_1000=y
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_XTOS_SCHED=y
CONFIG_XTOS_BCI=m
CONFIG_XTOS_BCI_OPENBCI=m
CONFIG_SERIAL_DEV_BUS=m
CONFIG_SERIAL_DEV_CTRL_TTYPORT=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
