# XTOS Kernel Configuration for Real-Time Performance
# Based on Linux 6.6 LTS + PREEMPT_RT patch

# Preemption Model
CONFIG_PREEMPT_RT=y
CONFIG_PREEMPT_COUNT=y
CONFIG_PREEMPTION=y

# NO_HZ: Tickless System
CONFIG_NO_HZ_FULL=y
CONFIG_NO_HZ=y
CONFIG_NO_HZ_COMMON=y
CONFIG_CONTEXT_TRACKING=y
CONFIG_CONTEXT_TRACKING_FORCE=y

# High Resolution Timers
CONFIG_HIGH_RES_TIMERS=y
CONFIG_TICK_ONESHOT=y

# IRQ Threading
CONFIG_IRQ_FORCED_THREADING=y
CONFIG_IRQ_FORCED_THREADING_DEFAULT=y

# RCU No-CB CPUs
CONFIG_RCU_NOCB_CPU=y
CONFIG_RCU_NOCB_CPU_DEFAULT_ALL=y
CONFIG_RCU_BOOST=y
CONFIG_RCU_BOOST_DELAY=500

# CPU Isolation
CONFIG_CPU_ISOLATION=y

# Real-Time Scheduler
CONFIG_RT_GROUP_SCHED=y

# Disable Debug Options for Performance
# CONFIG_DEBUG_KERNEL is not set
# CONFIG_DEBUG_INFO is not set
# CONFIG_STACKTRACE is not set

# Memory Management
CONFIG_SLUB=y
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_COMPACTION=y

# Architecture Specific (x86_64)
CONFIG_X86_64=y
CONFIG_SMP=y
CONFIG_X86_LOCAL_APIC=y
CONFIG_X86_IO_APIC=y

# Timer Frequency
CONFIG_HZ_1000=y
CONFIG_HZ=1000

# Power Management (minimal for RT)
# CONFIG_CPU_FREQ is not set
# CONFIG_CPU_IDLE is not set

# EEG Device Support Preparation
CONFIG_USB=y
CONFIG_USB_SERIAL=y
CONFIG_USB_ACM=y
CONFIG_SERIAL_8250=y
CONFIG_I2C=y
CONFIG_SPI=y

# Networking (basic)
CONFIG_NET=y
CONFIG_INET=y
CONFIG_UNIX=y
CONFIG_PACKET=y

# Filesystem Support
CONFIG_EXT4_FS=y
CONFIG_TMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# Block Layer
CONFIG_BLOCK=y
CONFIG_BLK_DEV_SD=y

# PCI Support
CONFIG_PCI=y
CONFIG_PCIEPORTBUS=y

# Input Devices
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y

# TTY and Console
CONFIG_TTY=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_UNIX98_PTYS=y

# Modules Support
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y

# Security
CONFIG_SECURITYFS=y
