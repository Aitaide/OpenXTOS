# XTOS configuration fragment for Linux 6.6 + PREEMPT_RT.
# Apply after kernel/patches/xtos-linux-6.6.patch.
CONFIG_EXPERT=y
CONFIG_PREEMPT_RT=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_HZ_1000=y
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_XTOS_SCHED=y
CONFIG_XTOS_BCI=m
CONFIG_XTOS_BCI_OPENBCI=m
CONFIG_SERIAL_DEV_BUS=y
CONFIG_SERIAL_DEV_CTRL_TTYPORT=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# Fail-closed userspace runner prerequisites; resolve and exercise separately
# in every architecture build. Landlock ABI >=3 is provided by Linux 6.6.
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_USER_NS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_SECURITY=y
CONFIG_SECURITYFS=y
CONFIG_SECURITY_LANDLOCK=y
CONFIG_LSM="landlock,lockdown,yama,loadpin,safesetid,selinux,smack,tomoyo,apparmor,bpf"
