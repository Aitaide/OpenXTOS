CONFIG_PREEMPT_RT=y
CONFIG_SMP=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_OVERLAY_FS=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_USB_STORAGE=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_BLK_DEV_SR=y
CONFIG_ISO9660_FS=y
CONFIG_VFAT_FS=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_I40E=y
CONFIG_IXGBE=y
CONFIG_E1000E=y
CONFIG_LOCALVERSION="-xtos-live.1"
CONFIG_LOCALVERSION_AUTO=n

# XTOS broad hardware support (2026-10-11): NICs, USB serial, WiFi, storage, VM
# Server/PC Ethernet
CONFIG_IGB=y
CONFIG_ICE=y
CONFIG_ALX=y
# VMware/virtualization NICs
CONFIG_VMXNET3=y
CONFIG_VMWARE_VMCI=y
# USB serial console adapters (industrial, dev boards, 5G modules)
CONFIG_USB_SERIAL=y
CONFIG_USB_SERIAL_GENERIC=y
CONFIG_USB_SERIAL_FTDI_SIO=y
CONFIG_USB_SERIAL_CP210X=y
CONFIG_USB_SERIAL_PL2303=y
CONFIG_USB_SERIAL_CH341=y
CONFIG_USB_SERIAL_OPTION=y
# WiFi (PC/mini devices; firmware loads from user space if present)
CONFIG_WLAN=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_IWLWIFI=y
CONFIG_IWLDVM=y
CONFIG_IWLMVM=y
CONFIG_ATH9K=y
CONFIG_ATH10K=y
CONFIG_ATH10K_PCI=y
CONFIG_RTL8XXXU=y
CONFIG_MT7921E=y
# RAID controllers (servers)
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_MEGARAID_SAS=y
CONFIG_SCSI_MPT3SAS=y
CONFIG_SCSI_AACRAID=y
CONFIG_AACRAID=y
CONFIG_MPT3SAS=y
# Filesystems
CONFIG_EXT4_FS=y
CONFIG_XFS_FS=y
# Device-mapper crypto (LUKS persistence volumes, 2026-10-12)
CONFIG_BLK_DEV_DM=y
CONFIG_DM_CRYPT=y
CONFIG_DM_UEVENT=y
CONFIG_CRYPTO_XTS=y

# Video4Linux2 camera input (AI vision input chain, 2026-10-18).
# Built as MODULES: nothing media-related touches the boot path until a
# camera actually appears; modprobe usb-video-class brings the stack up.
CONFIG_MEDIA_SUPPORT=m
CONFIG_MEDIA_SUPPORT_FILTER=y
CONFIG_MEDIA_USB_SUPPORT=y
CONFIG_MEDIA_CAMERA_SUPPORT=y
CONFIG_VIDEO_DEV=m
CONFIG_USB_VIDEO_CLASS=m

# GPU drivers: in-tree, quick-start for users (2026-10-19).
# Linux 7.3.1 i915 requires !PREEMPT_RT; keep the upstream safety guard.
# Xe2+ uses Xe; older Intel generations remain an explicit compatibility gap.
# virtio-gpu (VMs) remains built-in; AMD/NVIDIA/Intel Xe autoload as modules.
# AMD and NVIDIA display support ship as autoloadable MODULES — nothing
# media/GPU touches the boot path until the hardware is present.
CONFIG_DRM_AMDGPU=m
CONFIG_DRM_AMDGPU_SI=y
CONFIG_DRM_AMDGPU_CIK=y
CONFIG_DRM_NOUVEAU=m
CONFIG_DRM_XE=m
