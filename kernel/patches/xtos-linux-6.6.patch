diff --git a/kernel/sched/xtos_sched.c b/kernel/sched/xtos_sched.c
new file mode 100644
index 000000000..4e45d203b
--- /dev/null
+++ b/kernel/sched/xtos_sched.c
@@ -0,0 +1,307 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * XTOS scheduler helper.
+ *
+ * This is deliberately not a sched_class.  It provides an opt-in, locked
+ * O(1) priority queue that an integration layer may use without changing
+ * Linux's scheduler selection, task_struct layout, or syscall ABI.
+ */
+
+#include <linux/atomic.h>
+#include <linux/cpumask.h>
+#include <linux/errno.h>
+#include <linux/init.h>
+#include <linux/kernel.h>
+#include <linux/ktime.h>
+#include <linux/module.h>
+#include <linux/percpu.h>
+#include <linux/sched.h>
+#include <linux/spinlock.h>
+#include <linux/xtos.h>
+
+#include "xtos_prio.h"
+
+static DEFINE_PER_CPU(struct xtos_rq, xtos_runqueues);
+static atomic64_t xtos_total_enqueues;
+static atomic64_t xtos_total_dequeues;
+static atomic64_t xtos_total_picks;
+
+static void xtos_remove_locked(struct xtos_rq *rq, struct xtos_task *task)
+{
+	int ret;
+
+	ret = xtos_queue_dequeue(&rq->queues, &task->queue_node,
+				 task->xtos_priority);
+		if (WARN_ON_ONCE(ret))
+			return;
+
+	if (task->last_enqueue) {
+		task->wait_time += ktime_get_ns() - task->last_enqueue;
+		task->last_enqueue = 0;
+	}
+	task->on_rq = false;
+	task->rq = NULL;
+}
+
+struct xtos_rq *xtos_rq_for_cpu(int cpu)
+{
+	if (cpu < 0 || cpu >= nr_cpu_ids || !cpu_possible(cpu))
+		return NULL;
+	return &per_cpu(xtos_runqueues, cpu);
+}
+EXPORT_SYMBOL_GPL(xtos_rq_for_cpu);
+
+void init_xtos_rq(struct xtos_rq *rq)
+{
+	if (!rq)
+		return;
+
+	spin_lock_init(&rq->lock);
+	xtos_queue_set_init(&rq->queues);
+	rq->curr = NULL;
+	rq->total_switches = 0;
+	rq->avg_latency_ns = 0;
+	rq->last_schedule_time = 0;
+}
+EXPORT_SYMBOL_GPL(init_xtos_rq);
+
+int enqueue_task_xtos(struct xtos_rq *rq, struct xtos_task *task)
+{
+	unsigned long flags;
+	int ret;
+
+	if (!rq || !task || !task->initialized)
+		return -EINVAL;
+	if (!XTOS_PRIO_VALID(task->xtos_priority))
+		return -EINVAL;
+
+	spin_lock_irqsave(&task->state_lock, flags);
+	spin_lock(&rq->lock);
+	if (task->on_rq) {
+		ret = -EBUSY;
+		goto out;
+	}
+	ret = xtos_queue_enqueue(&rq->queues, &task->queue_node,
+					task->xtos_priority);
+	if (ret)
+		goto out;
+
+	task->on_rq = true;
+	task->rq = rq;
+	task->last_enqueue = ktime_get_ns();
+	atomic64_inc(&xtos_total_enqueues);
+out:
+	spin_unlock(&rq->lock);
+	spin_unlock_irqrestore(&task->state_lock, flags);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(enqueue_task_xtos);
+
+int dequeue_task_xtos(struct xtos_rq *rq, struct xtos_task *task)
+{
+	unsigned long flags;
+	int ret = 0;
+
+	if (!rq || !task || !task->initialized)
+		return -EINVAL;
+
+	spin_lock_irqsave(&task->state_lock, flags);
+	spin_lock(&rq->lock);
+	if (!task->on_rq || task->rq != rq) {
+		ret = -ENOENT;
+		goto out;
+	}
+	xtos_remove_locked(rq, task);
+	atomic64_inc(&xtos_total_dequeues);
+out:
+	spin_unlock(&rq->lock);
+	spin_unlock_irqrestore(&task->state_lock, flags);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(dequeue_task_xtos);
+
+struct xtos_task *pick_next_task_xtos(struct xtos_rq *rq)
+{
+	unsigned long flags;
+	struct xtos_queue_node *node;
+	struct xtos_task *task = NULL;
+
+	if (!rq)
+		return NULL;
+
+	spin_lock_irqsave(&rq->lock, flags);
+	node = xtos_queue_pick(&rq->queues);
+	if (node) {
+		task = container_of(node, struct xtos_task, queue_node);
+		atomic64_inc(&xtos_total_picks);
+	}
+	spin_unlock_irqrestore(&rq->lock, flags);
+
+	return task;
+}
+EXPORT_SYMBOL_GPL(pick_next_task_xtos);
+
+int xtos_task_init(struct xtos_task *xt, struct task_struct *task)
+{
+	if (!xt)
+		return -EINVAL;
+
+	memset(xt, 0, sizeof(*xt));
+	spin_lock_init(&xt->state_lock);
+	xt->task = task;
+	xt->xtos_priority = XTOS_PRIO_NORMAL;
+	xt->base_priority = XTOS_PRIO_NORMAL;
+	xt->cpu_affinity = XTOS_CPU_AFFINITY_NONE;
+	xt->initialized = true;
+	return 0;
+}
+EXPORT_SYMBOL_GPL(xtos_task_init);
+
+void xtos_task_destroy(struct xtos_task *xt)
+{
+	unsigned long flags;
+	struct xtos_rq *rq;
+	struct task_struct *task;
+
+	if (!xt || !xt->initialized)
+		return;
+
+	spin_lock_irqsave(&xt->state_lock, flags);
+	rq = xt->rq;
+	if (rq) {
+		spin_lock(&rq->lock);
+		if (xt->on_rq)
+			xtos_remove_locked(rq, xt);
+		spin_unlock(&rq->lock);
+	}
+	task = xt->task;
+	xt->task = NULL;
+	xt->initialized = false;
+	spin_unlock_irqrestore(&xt->state_lock, flags);
+
+	/* The task pointer is non-owning; its lifetime belongs to the caller. */
+	(void)task;
+}
+EXPORT_SYMBOL_GPL(xtos_task_destroy);
+
+int xtos_set_priority(struct xtos_task *xt, int priority)
+{
+	unsigned long flags;
+	struct xtos_rq *rq;
+	int old_priority;
+	int ret;
+
+	if (!xt || !xt->initialized || !XTOS_PRIO_VALID(priority))
+		return -EINVAL;
+
+	spin_lock_irqsave(&xt->state_lock, flags);
+	old_priority = xt->xtos_priority;
+	if (old_priority == priority) {
+		spin_unlock_irqrestore(&xt->state_lock, flags);
+		return 0;
+	}
+
+	rq = xt->rq;
+	if (!rq) {
+		xt->xtos_priority = priority;
+		xt->base_priority = priority;
+		spin_unlock_irqrestore(&xt->state_lock, flags);
+		return 0;
+	}
+
+	spin_lock(&rq->lock);
+	if (!xt->on_rq) {
+		ret = -ENOENT;
+		goto out;
+	}
+	ret = xtos_queue_dequeue(&rq->queues, &xt->queue_node, old_priority);
+	if (ret)
+		goto out;
+	xt->xtos_priority = priority;
+	xt->base_priority = priority;
+	ret = xtos_queue_enqueue(&rq->queues, &xt->queue_node, priority);
+	if (WARN_ON_ONCE(ret))
+		xt->xtos_priority = old_priority;
+out:
+	spin_unlock(&rq->lock);
+	spin_unlock_irqrestore(&xt->state_lock, flags);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(xtos_set_priority);
+
+int xtos_set_cpu_affinity(struct xtos_task *xt, int cpu)
+{
+	unsigned long flags;
+
+	if (!xt || !xt->initialized)
+		return -EINVAL;
+	if (cpu != XTOS_CPU_AFFINITY_NONE &&
+	    (cpu < 0 || cpu >= nr_cpu_ids || !cpu_possible(cpu)))
+		return -EINVAL;
+
+	spin_lock_irqsave(&xt->state_lock, flags);
+	/* Advisory metadata only; this helper does not migrate Linux tasks. */
+	xt->cpu_affinity = cpu;
+	spin_unlock_irqrestore(&xt->state_lock, flags);
+	return 0;
+}
+EXPORT_SYMBOL_GPL(xtos_set_cpu_affinity);
+
+int xtos_set_deadline(struct xtos_task *xt, __u64 deadline_ns)
+{
+	unsigned long flags;
+
+	if (!xt || !xt->initialized)
+		return -EINVAL;
+
+	spin_lock_irqsave(&xt->state_lock, flags);
+	xt->deadline_ns = deadline_ns;
+	spin_unlock_irqrestore(&xt->state_lock, flags);
+	return 0;
+}
+EXPORT_SYMBOL_GPL(xtos_set_deadline);
+
+void xtos_get_stats(struct xtos_task *xt, struct xtos_stats *stats)
+{
+	unsigned long flags;
+
+	if (!stats)
+		return;
+	memset(stats, 0, sizeof(*stats));
+	if (!xt || !xt->initialized)
+		return;
+
+	spin_lock_irqsave(&xt->state_lock, flags);
+	stats->total_runtime_ns = xt->total_runtime;
+	stats->wait_time_ns = xt->wait_time;
+	stats->context_switches = xt->context_switches;
+	stats->preempt_count = xt->preempt_count;
+	stats->deadline_misses = xt->deadline_misses;
+	spin_unlock_irqrestore(&xt->state_lock, flags);
+}
+EXPORT_SYMBOL_GPL(xtos_get_stats);
+
+static int __init xtos_sched_init(void)
+{
+	int cpu;
+
+	for_each_possible_cpu(cpu)
+		init_xtos_rq(&per_cpu(xtos_runqueues, cpu));
+
+	atomic64_set(&xtos_total_enqueues, 0);
+	atomic64_set(&xtos_total_dequeues, 0);
+	atomic64_set(&xtos_total_picks, 0);
+	pr_info("XTOS: optional O(1) scheduler helper initialized; Linux sched_class unchanged\n");
+	return 0;
+}
+module_init(xtos_sched_init);
+
+static void __exit xtos_sched_exit(void)
+{
+	pr_info("XTOS: scheduler helper unloaded\n");
+}
+module_exit(xtos_sched_exit);
+
+MODULE_LICENSE("GPL");
+MODULE_AUTHOR("XTOS Development Team");
+MODULE_DESCRIPTION("XTOS optional O(1) scheduler helper");
diff --git a/kernel/sched/xtos_prio.h b/kernel/sched/xtos_prio.h
new file mode 100644
index 000000000..dc8c8caeb
--- /dev/null
+++ b/kernel/sched/xtos_prio.h
@@ -0,0 +1,35 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _KERNEL_SCHED_XTOS_PRIO_H
+#define _KERNEL_SCHED_XTOS_PRIO_H
+
+#define XTOS_NR_PRIORITIES 15
+
+#define XTOS_PRIO_CRITICAL    0
+#define XTOS_PRIO_EEG_SIGNAL  1
+#define XTOS_PRIO_BCI_EVENT   2
+#define XTOS_PRIO_AR_RENDER   3
+#define XTOS_PRIO_AI_URGENT   4
+#define XTOS_PRIO_DEVICE_IO   5
+#define XTOS_PRIO_RT_HIGH     6
+#define XTOS_PRIO_RT_MED      7
+#define XTOS_PRIO_RT_LOW      8
+#define XTOS_PRIO_RT_MIN      9
+#define XTOS_PRIO_NORMAL      10
+#define XTOS_PRIO_BATCH_HIGH  11
+#define XTOS_PRIO_BATCH_MED   12
+#define XTOS_PRIO_BATCH_LOW   13
+#define XTOS_PRIO_IDLE        14
+
+#ifndef XTOS_PRIO_MIN
+#define XTOS_PRIO_MIN XTOS_PRIO_CRITICAL
+#endif
+#ifndef XTOS_PRIO_MAX
+#define XTOS_PRIO_MAX XTOS_PRIO_IDLE
+#endif
+
+#define XTOS_PRIO_VALID(prio) ((prio) >= XTOS_PRIO_MIN && \
+				   (prio) <= XTOS_PRIO_MAX)
+#define XTOS_PRIO_IS_RT(prio) ((prio) >= XTOS_PRIO_MIN && \
+				   (prio) <= XTOS_PRIO_RT_MIN)
+
+#endif /* _KERNEL_SCHED_XTOS_PRIO_H */
diff --git a/kernel/sched/xtos/Kconfig b/kernel/sched/xtos/Kconfig
new file mode 100644
index 000000000..0885dd476
--- /dev/null
+++ b/kernel/sched/xtos/Kconfig
@@ -0,0 +1,12 @@
+# SPDX-License-Identifier: GPL-2.0
+
+config XTOS_SCHED
+	tristate "XTOS optional scheduler helper"
+	default n
+	help
+	  Build the XTOS O(1) priority-queue helper as a loadable module or
+	  built-in component.  This does not replace Linux's sched_class and
+	  does not alter normal task scheduling.  It is intended for explicit
+	  integrations that own the xtos_task control blocks.
+
+	  If unsure, say N.
diff --git a/include/linux/xtos.h b/include/linux/xtos.h
new file mode 100644
index 000000000..08c18e659
--- /dev/null
+++ b/include/linux/xtos.h
@@ -0,0 +1,90 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _LINUX_XTOS_H
+#define _LINUX_XTOS_H
+
+#include <linux/types.h>
+
+#define XTOS_PRIO_MIN 0
+#define XTOS_PRIO_MAX 14
+#define XTOS_NR_PRIORITIES 15
+#define XTOS_CPU_AFFINITY_NONE (-1)
+
+/* Metadata passed between a caller and the optional XTOS helper. */
+struct xtos_attr {
+	__s32 priority;
+	__s32 cpu_affinity;
+	__u64 deadline_ns;
+	__u8 eeg_sensitive;
+	__u8 __reserved[7];
+};
+
+struct xtos_stats {
+	__u64 total_runtime_ns;
+	__u64 wait_time_ns;
+	__u64 context_switches;
+	__u64 preempt_count;
+	__u64 deadline_misses;
+};
+
+#ifdef __KERNEL__
+
+#include <linux/sched.h>
+#include <linux/spinlock_types.h>
+#include <linux/xtos_queue.h>
+
+struct xtos_rq;
+
+/*
+ * XTOS task state is an opt-in control block.  It is not embedded in
+ * task_struct and does not change Linux's active sched_class.
+ */
+struct xtos_task {
+	struct task_struct *task; /* non-owning reference supplied by the caller */
+	int xtos_priority;
+	int base_priority;
+	__u64 deadline_ns;
+	int cpu_affinity;
+
+	bool eeg_sensitive;
+	__u64 last_eeg_event;
+	int eeg_boost_level;
+
+	__u64 total_runtime;
+	__u64 wait_time;
+	__u64 last_enqueue;
+	__u64 context_switches;
+	__u64 preempt_count;
+	__u64 deadline_misses;
+
+	struct xtos_queue_node queue_node;
+	struct xtos_rq *rq;
+	spinlock_t state_lock;
+	bool on_rq;
+	bool initialized;
+};
+
+struct xtos_rq {
+	spinlock_t lock;
+	struct xtos_queue_set queues;
+	struct xtos_task *curr;
+	__u64 total_switches;
+	__u64 avg_latency_ns;
+	__u64 last_schedule_time;
+};
+
+struct xtos_rq *xtos_rq_for_cpu(int cpu);
+void init_xtos_rq(struct xtos_rq *rq);
+int enqueue_task_xtos(struct xtos_rq *rq, struct xtos_task *task);
+int dequeue_task_xtos(struct xtos_rq *rq, struct xtos_task *task);
+struct xtos_task *pick_next_task_xtos(struct xtos_rq *rq);
+
+int xtos_task_init(struct xtos_task *xt, struct task_struct *task);
+void xtos_task_destroy(struct xtos_task *xt);
+int xtos_set_priority(struct xtos_task *xt, int priority);
+int xtos_set_cpu_affinity(struct xtos_task *xt, int cpu);
+int xtos_set_deadline(struct xtos_task *xt, __u64 deadline_ns);
+void xtos_get_stats(struct xtos_task *xt, struct xtos_stats *stats);
+
+#endif /* __KERNEL__ */
+
+#endif /* _LINUX_XTOS_H */
diff --git a/include/linux/xtos_bci.h b/include/linux/xtos_bci.h
new file mode 100644
index 000000000..709d265e3
--- /dev/null
+++ b/include/linux/xtos_bci.h
@@ -0,0 +1,182 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * XTOS BCI (Brain-Computer Interface) Driver Framework
+ * 
+ * Unified abstraction layer for EEG/brain sensing devices
+ * Copyright (C) 2026 XTOS Project
+ */
+
+#ifndef _LINUX_XTOS_BCI_H
+#define _LINUX_XTOS_BCI_H
+
+#include <linux/types.h>
+#include <linux/device.h>
+#include <linux/cdev.h>
+#include <linux/list.h>
+#include <linux/spinlock.h>
+#include <linux/wait.h>
+#include <linux/dma-mapping.h>
+#include <linux/mutex.h>
+#include <linux/kref.h>
+
+/* BCI device interface types */
+enum xtos_bci_interface {
+	XTOS_BCI_SERIAL,
+	XTOS_BCI_USB,
+	XTOS_BCI_BLUETOOTH,
+	XTOS_BCI_NETWORK
+};
+
+/* Forward declarations */
+struct xtos_bci_dev;
+struct xtos_bci_ringbuf;
+struct xtos_bci_config_v1;
+struct xtos_bci_frame_v1;
+struct xtos_bci_frame_ring;
+
+/* Device operation callbacks */
+struct xtos_bci_device_ops {
+	/* Wake in-flight operations before unregister waits for op_lock. */
+	void (*cancel)(struct xtos_bci_dev *dev);
+	/* Initialization and cleanup */
+	int (*init)(struct xtos_bci_dev *dev);
+	void (*cleanup)(struct xtos_bci_dev *dev);
+	
+	/* Data acquisition */
+	int (*start_stream)(struct xtos_bci_dev *dev);
+	int (*stop_stream)(struct xtos_bci_dev *dev);
+	int (*read_samples)(struct xtos_bci_dev *dev,
+	                    s32 *buffer,
+	                    size_t num_samples);
+	
+	/* Configuration. Cyton accepts 250Hz only as a stopped readback assertion;
+	 * its firmware rate command resets unrelated ADS settings. */
+	int (*set_sampling_rate)(struct xtos_bci_dev *dev, int rate);
+	int (*set_channel_enable)(struct xtos_bci_dev *dev, 
+	                          int channel, 
+	                          bool enable);
+	int (*set_gain)(struct xtos_bci_dev *dev, 
+	                int channel, 
+	                int gain);
+	
+	int (*set_channel_config)(struct xtos_bci_dev *dev, int channel,
+				  bool enabled, int gain);
+	int (*get_config)(struct xtos_bci_dev *dev,
+			  struct xtos_bci_config_v1 *config);
+
+	/* Calibration */
+	int (*calibrate)(struct xtos_bci_dev *dev);
+	int (*impedance_check)(struct xtos_bci_dev *dev, 
+	                      __u32 *impedances_kohm);
+};
+
+/* BCI device descriptor */
+struct xtos_bci_dev {
+	/* Device identification */
+	char name[32];              /* Device name (e.g., "OpenBCI Cyton") */
+	int dev_id;                 /* Unique device ID */
+	
+	/* Hardware parameters */
+	int num_channels;           /* Number of channels */
+	int sampling_rate;          /* Sampling rate (Hz) */
+	int resolution_bits;        /* ADC resolution (bits) */
+	int input_range_mv;         /* Input range (millivolts, integer) */
+	
+	/* Connection information */
+	enum xtos_bci_interface interface;
+	void *hw_private;           /* Hardware private data */
+	
+	/* Operation callbacks */
+	const struct xtos_bci_device_ops *ops;
+	struct module *owner;       /* Callback/free code, pinned by each open FD */
+	void (*release)(struct xtos_bci_dev *dev); /* Final allocation destructor */
+	struct kref ref;
+	struct mutex op_lock;       /* Controls/open/cleanup, never held while waiting */
+	struct mutex read_lock;     /* Serialize read snapshot/commit */
+	bool disconnected;
+	bool registered;
+	
+	/* Ring buffer */
+	struct xtos_bci_ringbuf *ringbuf;
+	struct xtos_bci_frame_ring *frames; /* CPU-owned, final device put frees. */
+	
+	/* Character device */
+	struct cdev *cdev;          /* Independently refcounted by VFS */
+	struct device *device;
+	dev_t devt;                 /* Device number (major:minor) */
+	
+	/* Statistics: RX and core GET/RESET_STATS all hold lock below. */
+	unsigned long samples_read;
+	unsigned long samples_dropped;
+	unsigned long errors;
+	
+	/* State */
+	bool opened;
+	bool streaming;
+	int acquisition_error;       /* Negative errno; buffered bytes drain first. */
+	spinlock_t lock;
+	
+	/* Global device list */
+	struct list_head list;
+};
+
+/* Zero-copy ring buffer */
+struct xtos_bci_ringbuf {
+	void *buffer;               /* DMA buffer */
+	dma_addr_t dma_handle;      /* DMA physical address */
+	struct device *dma_dev;     /* Retained original allocation device */
+	size_t size;                /* Buffer size (bytes) */
+	
+	unsigned long write_pos;    /* Write pointer */
+	unsigned long read_pos;     /* Read pointer */
+	
+	spinlock_t lock;            /* Spinlock */
+	wait_queue_head_t wait;     /* Wait queue */
+	
+	/* Performance statistics */
+	unsigned long overruns;     /* Overflow count */
+	unsigned long max_fill;     /* Maximum fill level */
+};
+
+/* Core API functions */
+/* init gives the caller one reference; register holds another until unregister.
+ * Caller closes/quiesces transport before dropping its reference. Final put
+ * frees the ring and invokes release; successful open holds ref + owner pin.
+ */
+void xtos_bci_device_init(struct xtos_bci_dev *dev);
+void xtos_bci_get_device(struct xtos_bci_dev *dev);
+void xtos_bci_put_device(struct xtos_bci_dev *dev);
+int xtos_bci_register_device(struct xtos_bci_dev *dev);
+void xtos_bci_unregister_device(struct xtos_bci_dev *dev);
+
+/* Ring buffer API */
+struct xtos_bci_ringbuf *xtos_bci_ringbuf_alloc(struct device *dev, size_t size);
+void xtos_bci_ringbuf_free(struct device *dev, struct xtos_bci_ringbuf *rb);
+int xtos_bci_ringbuf_write(struct xtos_bci_ringbuf *rb, 
+                           const void *data, 
+                           size_t len);
+int xtos_bci_ringbuf_read(struct xtos_bci_ringbuf *rb, 
+                          void *data, 
+                          size_t len);
+size_t xtos_bci_ringbuf_available(struct xtos_bci_ringbuf *rb);
+
+/* Enable in sleepable initialization before admitting RX. Producer lifetime and
+ * current-generation admission belong to the driver; publish never allocates. */
+int xtos_bci_device_frames_enable(struct xtos_bci_dev *dev, unsigned int capacity);
+int xtos_bci_device_frame_publish(struct xtos_bci_dev *dev,
+                                const struct xtos_bci_frame_v1 *frame,
+                                const struct xtos_bci_config_v1 *config);
+void xtos_bci_device_frames_wake(struct xtos_bci_dev *dev);
+
+/* Device registration macro */
+#define XTOS_BCI_DEVICE_REGISTER(name, ops_ptr) \
+	static int __init name##_init(void) { \
+		return xtos_bci_register_device(&name##_dev); \
+	} \
+	static void __exit name##_exit(void) { \
+		xtos_bci_unregister_device(&name##_dev); \
+	} \
+	module_init(name##_init); \
+	module_exit(name##_exit);
+
+#endif /* _LINUX_XTOS_BCI_H */
diff --git a/include/linux/xtos_queue.h b/include/linux/xtos_queue.h
new file mode 100644
index 000000000..821c812eb
--- /dev/null
+++ b/include/linux/xtos_queue.h
@@ -0,0 +1,129 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _LINUX_XTOS_QUEUE_H
+#define _LINUX_XTOS_QUEUE_H
+
+/*
+ * Small, intrusive O(1) priority queue core shared by the kernel helper and
+ * the user-space unit test.  The caller provides any required locking.
+ */
+#ifdef __KERNEL__
+#include <linux/errno.h>
+#else
+#include <errno.h>
+#include <stddef.h>
+#endif
+
+#define XTOS_QUEUE_NR_PRIORITIES 15
+
+struct xtos_queue;
+
+struct xtos_queue_node {
+	struct xtos_queue_node *prev;
+	struct xtos_queue_node *next;
+	struct xtos_queue *owner;
+};
+
+struct xtos_queue {
+	struct xtos_queue_node *head;
+	struct xtos_queue_node *tail;
+};
+
+struct xtos_queue_set {
+	struct xtos_queue queue[XTOS_QUEUE_NR_PRIORITIES];
+	unsigned long bitmap;
+	unsigned int nr_running;
+};
+
+static inline int xtos_queue_prio_valid(int priority)
+{
+	return priority >= 0 && priority < XTOS_QUEUE_NR_PRIORITIES;
+}
+
+static inline void xtos_queue_set_init(struct xtos_queue_set *set)
+{
+	unsigned int i;
+
+	for (i = 0; i < XTOS_QUEUE_NR_PRIORITIES; i++) {
+		set->queue[i].head = NULL;
+		set->queue[i].tail = NULL;
+	}
+	set->bitmap = 0;
+	set->nr_running = 0;
+}
+
+static inline int xtos_queue_enqueue(struct xtos_queue_set *set,
+					 struct xtos_queue_node *node, int priority)
+{
+	struct xtos_queue *queue;
+
+	if (!set || !node || !xtos_queue_prio_valid(priority))
+		return -EINVAL;
+	if (node->owner)
+		return -EBUSY;
+
+	queue = &set->queue[priority];
+	node->prev = queue->tail;
+	node->next = NULL;
+	node->owner = queue;
+	if (queue->tail)
+		queue->tail->next = node;
+	else
+		queue->head = node;
+	queue->tail = node;
+	set->bitmap |= 1UL << priority;
+	set->nr_running++;
+
+	return 0;
+}
+
+static inline int xtos_queue_dequeue(struct xtos_queue_set *set,
+					 struct xtos_queue_node *node, int priority)
+{
+	struct xtos_queue *queue;
+
+	if (!set || !node || !xtos_queue_prio_valid(priority))
+		return -EINVAL;
+
+	queue = &set->queue[priority];
+	if (node->owner != queue)
+		return -ENOENT;
+
+	if (node->prev)
+		node->prev->next = node->next;
+	else
+		queue->head = node->next;
+	if (node->next)
+		node->next->prev = node->prev;
+	else
+		queue->tail = node->prev;
+
+	node->prev = NULL;
+	node->next = NULL;
+	node->owner = NULL;
+	if (!queue->head)
+		set->bitmap &= ~(1UL << priority);
+	if (set->nr_running)
+		set->nr_running--;
+
+	return 0;
+}
+
+static inline struct xtos_queue_node *xtos_queue_pick(struct xtos_queue_set *set)
+{
+	unsigned int priority;
+
+	if (!set)
+		return NULL;
+
+	while (set->bitmap) {
+		priority = (unsigned int)__builtin_ctzl(set->bitmap);
+		if (set->queue[priority].head)
+			return set->queue[priority].head;
+		/* Repair a stale bit and continue to the next priority. */
+		set->bitmap &= ~(1UL << priority);
+	}
+
+	return NULL;
+}
+
+#endif /* _LINUX_XTOS_QUEUE_H */
diff --git a/include/uapi/linux/xtos_bci.h b/include/uapi/linux/xtos_bci.h
