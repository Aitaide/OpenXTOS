+static void write_checked(int fd, const char *text) {
+    size_t size = strlen(text);
+    size_t used = 0;
+    while (used < size) {
+        ssize_t count = write(fd, text + used, size - used);
+        if (count < 0 && errno == EINTR) continue;
+        if (count <= 0) _exit(97);
+        used += (size_t)count;
+    }
+}
